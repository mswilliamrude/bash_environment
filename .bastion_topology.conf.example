# ==============================================================================
# BASTION TOPOLOGY CONFIGURATION (EXAMPLE)
# ==============================================================================
# Rename this file to .bastion_topology.conf (or ~/.bastion_topology.conf)
# and populate it with your environment's sensitive data.
# This file is explicitly ignored by Git to prevent accidental leakage of
# internal IP addresses, subscription IDs, and infrastructure naming.

# ==============================================================================
# TOPOLOGY OVERVIEW
# ==============================================================================
#
#  [Local Machine]
#         |
#         | (az network bastion tunnel)
#         |
#   [Azure Bastion]
#         |
#         +------------------------------------+
#         |                                    |
#  (Standard Dev VM)                  (Sandbox Environment)
#  e.g., api0, redis0                 e.g., jumpbox01
#         |                                    |
#    [Target VM]                     [Azure Public IP]
#                                              | (az ssh vm)
#                                              |
#                                       [Jumpbox VM]
#                                              |
#                                              +-- (Port Fwd 172.x.x.x:22)
#                                              |     -> [Inner Target A]
#                                              |
#                                              +-- (Port Fwd 172.x.x.x:3389)
#                                              |     -> [Inner Target B]
#                                              |
#                                     (plink subshell)
#                                              |
#                                      [Deep Target]
#                                      x.x.x.a:22
#                                              |
#                                       (ssh proxyjump)
#                                              |
#                                     [Deeper Target 2]
#                                      x.x.x.b:22
#
# ==============================================================================

# ==============================================================================
# BASTION_VMS (Core Virtual Machine Routing)
# ==============================================================================
# Format: "alias|azure_name|resource_group|subscription_name|port|type|autostart|auth_type"
#
# Column Breakdown:
# 1. alias             : Short name used in CLI commands (e.g., `bastion api0`)
# 2. azure_name        : Exact name of the virtual machine resource in Azure
# 3. resource_group    : Azure Resource Group containing the VM
# 4. subscription_name : Name of the Azure Subscription containing the VM
# 5. port              : Local localhost port to bind for the Bastion/SSH tunnel (e.g., 12022)
# 6. type              : The Routing Topology engine to use:
#                        - 'flat'       = Standard 1:1 Bastion tunnel directly to target VM
#                        - 'flat-entra' = Flat Bastion tunnel + 'az network bastion ssh' for AAD token
#                        - 'tiered'     = Advanced multi-hop routing ('az ssh vm' -> proxy jumps)
# 7. autostart         : true/false. If true, script will attempt to `az vm start` if it is stopped.
# 8. auth_type         : Interactive Session Identity:
#                        - 'ssh'       = Standard SSH key (relies on local MSYS2 ssh-agent/pageant)
#                        - 'entra'     = Injects Entra ID username (requires 'flat-entra' topology)
#                        - '<string>'  = Specific SSH username override (e.g., 'ubuntu' or 'root')

BASTION_VMS=(
    "api0|vm-api-dev-01|rg-project-dev|Sub_Dev_Environment|12022|flat|true|azureuser"
    "redis0|vm-cache-dev-01|rg-project-dev|Sub_Dev_Environment|13022|flat|true|azureuser"
    "jbox|vm-jumpbox-sandbox-01|rg-sandbox-net|Sub_Sandbox_Environment|10022|tiered|false|entra"
    "secvdi|vm-secure-vdi-01|rg-secure-net|Sub_Secure_Environment|20000|flat-entra|false|entra"
)


# ==============================================================================
# VM_PROPS (Dynamic Engine Properties & Overrides)
# ==============================================================================
# Attach arbitrary, script-specific data to any alias.
# The routing engine dynamically queries these based on the topology type.
#
# Recognized Keys:
#
#   <alias>_az_tunnels
#       Space-separated SSH -L port forward mappings injected into the base
#       Bastion tunnel SSH command. Use this to expose private network services
#       (databases, APIs, Redis) on localhost without a separate tunnel step.
#       Format: "local_port:remote_ip:remote_port"
#       Example: "5432:10.0.1.5:5432 6379:10.0.1.6:6379"
#
#   <alias>_plink_tunnels
#       Space-separated tunnel mappings injected into the background plink
#       subshell process. Used in 'tiered' topology to reach deep inner hosts
#       that are only accessible from the jumpbox, not from the Bastion.
#       Format: "local_port:remote_ip:remote_port"
#       Example: "2023:192.168.1.25:22 8443:172.16.30.2:443"
#
#   <alias>_plink_entry_port
#       Overrides the default port (2022) that plink uses to enter the jumpbox
#       for the subshell tunnel session. Only needed if the jumpbox SSH port
#       forwarded by az_tunnels is not 2022.
#       Example: "2022"
#
#   <alias>_fwd_ports
#       Space-separated list of ALL local ports opened by this alias (az_tunnels
#       + plink_tunnels combined). Populated automatically by bastion_wizard.
#       Used by `cleanup_tunnels <alias>` to find and kill the right processes.
#       Example: "5432 6379 2023 8443"
#
#   <alias>_bastion_name
#       Overrides the Azure Bastion resource name for this specific VM.
#       Use when a VM is only reachable via a non-default Bastion instance
#       (e.g., a VM in a secure/isolated subscription with its own Bastion).
#       Example: "bst-secure-isolated-01"
#
#   <alias>_bastion_rg
#       Overrides the Resource Group where the above Bastion is located.
#       Only needed when <alias>_bastion_name is set AND the Bastion lives
#       in a different Resource Group than the VM itself.
#       Example: "rg-secure-net"
#
#   <alias>_fwd_user
#       SSH username used specifically for the port-forward SSH session.
#       Only relevant for 'flat-entra' VMs where the interactive session uses
#       an Entra ID (AAD) certificate, but the port-forward SSH leg requires
#       a regular key-based identity (different username format).
#       Example: "user@contoso.com"
#
#   <alias>_fwd_identity
#       Path to the SSH private key used for the port-forward SSH session.
#       Only relevant for 'flat-entra' VMs. If omitted, the ssh-agent default
#       key is used. Supports ~ expansion.
#       Example: "~/.ssh/id_entra"
#
#   global_default_bastion
#       Fallback Azure Bastion resource name used for any VM that does not
#       have an alias-specific <alias>_bastion_name override. Every environment
#       should define this — without it, connections will fail loudly.
#       Example: "bst-default-region-01"

declare -A VM_PROPS

# --- Properties for 'tiered' type profiles (e.g., jbox) ---
# Tunnels hidden behind the jumpbox accessible via az ssh vm injection
VM_PROPS["jbox_az_tunnels"]="2022:x.x.x.x:22 13389:x.x.x.x:3389"
# Deep tunnels injected into the background subshell
VM_PROPS["jbox_plink_tunnels"]="2023:x.x.x.a:22 2024:x.x.x.b:22"
# Track all local ports so `cleanup_tunnels jbox` gracefully shuts them down
VM_PROPS["jbox_fwd_ports"]="2022 13389 2023 2024"

# --- Properties for specialized profiles (e.g., secvdi) ---
# Overrides the default bastion host to use an isolated, highly secure bastion deployment
VM_PROPS["secvdi_bastion_name"]="bst-secure-isolated-01"
VM_PROPS["secvdi_bastion_rg"]="rg-secure-net"

# --- Properties for flat-entra VMs that also need port forwards (e.g., sentinelprism) ---
# The interactive session uses Entra ID (az network bastion ssh --auth-type AAD),
# but the port-forward SSH leg needs a regular key-based identity.
# fwd_user:     the UPN / SSH username for the port-forward session
# fwd_identity: path to the SSH private key for the port-forward session
VM_PROPS["sentinelprism_az_tunnels"]="8080:10.0.10.6:8080 8081:10.0.10.7:8080"
VM_PROPS["sentinelprism_fwd_ports"]="8080 8081"
VM_PROPS["sentinelprism_fwd_user"]="user@contoso.com"
VM_PROPS["sentinelprism_fwd_identity"]="~/.ssh/id_rsa_contoso"

# --- Global defaults ---
# Used by standard 'flat' VMs if no specific profile exists
VM_PROPS["global_default_bastion"]="bst-default-region-01"
